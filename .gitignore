# VSIX archives are local packaging outputs. They are intentionally generated
# outside dist/vscode so editor extension source remains only package.json plus
# theme JSON files; committing archives would make normal palette diffs noisy.
dist/vsix/*.vsix
dist/vscode/*.vsix

# Python bytecode is regenerated by local validation runs.
__pycache__/
*.py[cod]

# Claude's local launch/session files can contain absolute /private/tmp paths.
# They are useful for a single machine while debugging, but committing them would
# make another checkout point at stale temporary directories.
.claude/launch.json
.claude/settings.local.json

# This self-link was created only for local editor testing. Keeping it out of
# Git avoids a platform-sensitive symlink that does not describe the theme.
/lucretia
