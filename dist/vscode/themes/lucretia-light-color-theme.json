    "type.declaration": "#155FA6",
    "keyword": "#A02F6E",
    "string": "#678005",
    "number": "#5D409D",
    "operator": "#7D7D7C",
    "comment": {
      "foreground": "#929291",
      "fontStyle": "italic"
    }
  },
