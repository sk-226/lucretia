    "terminal.ansiBrightGreen": "#8EA746",
    "terminal.ansiBrightYellow": "#D5AC45",
    "terminal.ansiBrightBlue": "#4687CC",
    "terminal.ansiBrightMagenta": "#C95B95",
    "terminal.ansiBrightCyan": "#47ACA3"
