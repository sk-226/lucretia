    "type.declaration": "#155FA6",
    "keyword": "#A02F6E",
    "string": "#678005",
    "number": "#5D409D",
    "operator": "#7F7D77",
    "comment": {
      "foreground": "#94928B",
      "fontStyle": "italic"
    }
  },
